---
/**
 * One page per EVD opcode, generated from src/data/evd-commands.ts.
 *
 * Everything shown here is derived from that single dataset, so a command page
 * cannot disagree with the opcode reference table or the address popups.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { EVD_COMMANDS, type EvdCommand } from '../../../data/evd-commands';
import { evdTitle } from '../../../data/evd-names';
import AddrRef from '../../../components/AddrRef.astro';
import FilterTable from '../../../components/FilterTable.astro';

export function getStaticPaths() {
  return EVD_COMMANDS.map((command, i) => ({
    params: { hex: command.hex },
    props: {
      command,
      prev: EVD_COMMANDS[i - 1] ?? null,
      next: EVD_COMMANDS[i + 1] ?? null,
    },
  }));
}

interface Props {
  command: EvdCommand;
  prev: EvdCommand | null;
  next: EvdCommand | null;
}

const { command: c, prev, next } = Astro.props;

/** Split on backticks so `like this` renders as code. */
function segments(text: string) {
  return text.split('`').map((part, i) => ({ code: i % 2 === 1, text: part }));
}

const title = evdTitle(c);
const isMarker = c.num >= 0xf0;

const description =
  c.behavior.replace(/`/g, '').slice(0, 160) ||
  `EVD opcode ${c.opcode}, handled by ${c.handler}.`;

// Only advertise sections that actually have content on this page.
const headings = [
  { depth: 2, slug: 'at-a-glance', text: 'At a glance' },
  c.forms.length > 1 && { depth: 2, slug: 'documented-forms', text: 'Documented forms' },
  c.behavior && { depth: 2, slug: 'handler-behaviour', text: 'Handler behaviour' },
  { depth: 2, slug: 'encoding', text: 'Encoding' },
  c.params.length > 0 && { depth: 2, slug: 'operand-fields', text: 'Operand fields' },
  c.calls.length > 0 && { depth: 2, slug: 'engine-calls', text: 'Engine calls' },
  c.masks.length > 0 && { depth: 2, slug: 'bit-masks', text: 'Bit masks' },
].filter(Boolean) as { depth: number; slug: string; text: string }[];

// The ENG and JPN maps are derived and only confirm 85 of the 138 handlers, so
// a missing address means "not confirmed in that build", not "absent".
const addrRows = [
  { label: 'Debug', detail: 'SLUS-21262 prototype', addr: c.debug ?? '' },
  { label: 'ENG', detail: 'USA release', addr: c.eng ?? '' },
  { label: 'JPN', detail: 'SLPM-65800 release', addr: c.jpn ?? '' },
];
const unconfirmedBuilds = [!c.eng && 'ENG', !c.jpn && 'JPN'].filter(Boolean);
---

<StarlightPage frontmatter={{ title, description }} headings={headings}>
  <p class="lede">
    {c.behavior ? segments(c.behavior).map((s) => (s.code ? <code>{s.text}</code> : s.text)) : null}
  </p>

  <p>
    <span class:list={['ev', `ev--${c.evidence}`]}>{c.evidence}</span>
    {
      c.evidence === 'proven' ? (
        <span class="ev-note">
          — handler traced, and exercised by at least one shipped script.
        </span>
      ) : (
        <span class="ev-note">
          — handler traced, but <strong>no shipped script uses this opcode</strong>, so the operand
          layout rests on the trace alone with no real data to check it against.
        </span>
      )
    }
  </p>

  <h2 id="at-a-glance">At a glance</h2>

  <table class="facts">
    <tbody>
      <tr>
        <th>Opcode</th>
        <td><code>{c.opcode}</code> ({c.num})</td>
      </tr>
      <tr>
        <th>Handler</th>
        <td><code>{c.handler}</code></td>
      </tr>
      {
        c.signature && (
          <tr>
            <th>Signature</th>
            <td>
              <code>{c.signature}</code>
            </td>
          </tr>
        )
      }
      {
        c.sourceFile && (
          <tr>
            <th>Translation unit</th>
            <td>
              <code>{c.sourceFile}</code>
            </td>
          </tr>
        )
      }
      <tr>
        <th>Address</th>
        <td>
          <AddrRef label={c.debug ?? '—'} title={c.handler} rows={addrRows} />
          <span class="facts__hint">
            {
              addrRows.filter((r) => r.addr).length > 1
                ? `— debug build; click for all ${addrRows.filter((r) => r.addr).length}`
                : '— debug build, the only one that confirms it'
            }
          </span>
          {
            unconfirmedBuilds.length > 0 && (
              <div class="facts__caveat">
                Not confirmed in the {unconfirmedBuilds.join(' or ')} map
                {unconfirmedBuilds.length > 1 ? 's' : ''}. Those maps are derived and omit any
                function whose body does not match the reference build, so the handler exists —
                its address simply has not been pinned down there.
              </div>
            )
          }
        </td>
      </tr>
      {
        c.size !== null && (
          <tr>
            <th>Handler size</th>
            <td>
              <code>0x{c.size.toString(16).toUpperCase()}</code> ({c.size} bytes)
            </td>
          </tr>
        )
      }
      {
        c.engineNames.length > 0 && (
          <tr>
            <th>Engine name</th>
            <td>
              {c.engineNames.map((n, i) => (
                <>
                  {i > 0 && ', '}
                  <code>{n}</code>
                </>
              ))}
            </td>
          </tr>
        )
      }
      <tr>
        <th>Family</th>
        <td>{c.family}</td>
      </tr>
      <tr>
        <th>Command size</th>
        <td>
          {
            isMarker ? (
              <>
                Always 4 bytes — opcodes <code>&gt;= 0xF0</code> ignore the extra-word count.
              </>
            ) : (
              <>
                <code>4 + extra_words * 4</code> bytes
              </>
            )
          }
        </td>
      </tr>
    </tbody>
  </table>

  {
    c.forms.length > 1 && (
      <>
        <h2 id="documented-forms">Documented forms</h2>
        <p>
          This opcode is documented under more than one name, one per branch of the handler. They
          are the same opcode and the same handler; which branch runs is chosen by the argument
          byte or a control word.
        </p>
        <table>
          <thead>
            <tr>
              <th>Form</th>
              <th>Engine name</th>
              <th>What it does</th>
            </tr>
          </thead>
          <tbody>
            {c.forms.map((f) => (
              <tr>
                <td>
                  <code>{f.name}</code>
                </td>
                <td>{f.engineName ? <code>{f.engineName}</code> : <span class="none">—</span>}</td>
                <td>{f.summary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    c.behavior && (
      <>
        <h2 id="handler-behaviour">Handler behaviour</h2>
        <p>{segments(c.behavior).map((s) => (s.code ? <code>{s.text}</code> : s.text))}</p>
      </>
    )
  }

  <h2 id="encoding">Encoding</h2>

  <p>
    The command header is one 32-bit word, as described in{' '}
    <a href="../../format/#3-instruction-encoding">§3 Instruction encoding</a>:
  </p>

  <pre><code>{` 31            24 23            16 15             8 7              0
+----------------+----------------+----------------+----------------+
|  flags         |  argument byte |  extra words   |  ${c.opcode.padEnd(14)}|
+----------------+----------------+----------------+----------------+`}</code></pre>

  {
    isMarker ? (
      <p>
        Because this opcode is <code>&gt;= 0xF0</code>, the stepper consumes only the header and
        ignores the extra-word count. The payload therefore lives in the header word itself — see{' '}
        <a href="../../control-flow/#4-0xf0-markers">§4 <code>0xF0</code> markers</a>.
      </p>
    ) : (
      <p>
        Bits 8–15 give the number of 32-bit operand words that follow. Bits 16–23 are handed to the
        handler as a bitfield; on character commands bit <code>0</code> normally says whether a
        character selector word is present. Bit 31 is the{' '}
        <a href="../../format/#32-the-keep-going-bit">keep-going bit</a>.
      </p>
    )
  }

  {
    c.params.length > 0 && (
      <>
        <h2 id="operand-fields">Operand fields</h2>
        <p>
          {c.params.length} documented field{c.params.length === 1 ? '' : 's'}.{' '}
          <strong>input</strong> fields are read from the command's operand words;{' '}
          <strong>derived</strong> fields are computed from other fields rather than stored
          separately.
        </p>
        <FilterTable noun="fields" placeholder="Filter fields…">
          <table>
            <thead>
              <tr>
                <th class="p-name">Field</th>
                <th class="p-role">Role</th>
                <th>Meaning</th>
              </tr>
            </thead>
            <tbody>
              {c.params.map((p) => (
                <tr class:list={{ dim: p.role === 'derived' }}>
                  <td class="p-name">
                    <code>{p.name}</code>
                  </td>
                  <td class="p-role">{p.role}</td>
                  <td>{segments(p.meaning).map((s) => (s.code ? <code>{s.text}</code> : s.text))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </FilterTable>
      </>
    )
  }

  {
    c.calls.length > 0 && (
      <>
        <h2 id="engine-calls">Engine calls</h2>
        <p>Engine functions this handler was observed calling:</p>
        <ul class="calls">
          {c.calls.map((fn) => (
            <li>
              <code>{fn}</code>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    c.masks.length > 0 && (
      <>
        <h2 id="bit-masks">Bit masks</h2>
        <p>Masks the handler applies to its argument byte or operand words:</p>
        <p>
          {c.masks.map((m, i) => (
            <>
              {i > 0 && ' '}
              <code>{m}</code>
            </>
          ))}
        </p>
      </>
    )
  }

  <hr />

  <nav class="cmd-nav" aria-label="Adjacent opcodes">
    <div>
      {
        prev && (
          <a href={`../${prev.hex}/`}>
            ← <code>{prev.opcode}</code> {evdTitle(prev).split('— ')[1] ?? ''}
          </a>
        )
      }
    </div>
    <div><a href="../../opcodes/">All opcodes</a></div>
    <div class="cmd-nav__next">
      {
        next && (
          <a href={`../${next.hex}/`}>
            <code>{next.opcode}</code> {evdTitle(next).split('— ')[1] ?? ''} →
          </a>
        )
      }
    </div>
  </nav>
</StarlightPage>

<style>
  .lede {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }
  .facts th {
    text-align: left;
    white-space: nowrap;
    width: 1%;
    vertical-align: top;
  }
  .facts code {
    word-break: break-word;
  }
  .facts__hint {
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-xs);
    margin-inline-start: 0.5rem;
  }
  .facts__caveat {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    margin-block-start: 0.35rem;
    max-width: 60ch;
  }
  .none {
    color: var(--sl-color-gray-4);
  }
  .p-name,
  .p-role {
    white-space: nowrap;
  }
  .p-name code {
    color: var(--rs-peach);
  }
  .calls {
    columns: 2 22rem;
    gap: 1.5rem;
  }
  .calls li {
    break-inside: avoid;
  }
  .calls code {
    font-size: var(--sl-text-xs);
  }
  .ev {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0 0.4em;
    border-radius: 0.2rem;
    white-space: nowrap;
  }
  .ev--proven {
    color: var(--rs-green);
    background: color-mix(in srgb, var(--rs-green) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--rs-green) 40%, transparent);
  }
  .ev--traced {
    color: var(--rs-peach);
    background: color-mix(in srgb, var(--rs-peach) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--rs-peach) 40%, transparent);
  }
  .ev-note {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .cmd-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    font-size: var(--sl-text-sm);
  }
  .cmd-nav__next {
    text-align: right;
  }
</style>
